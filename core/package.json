{
  "name": "@social9/core",
  "version": "1.0.0",
  "description": "The on-device engine behind Social9: AI cut-outs, face detection, image decoding, format conversion and metadata removal. Runs entirely in the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./ml/*": "./src/ml/*.ts",
    "./image/*": "./src/image/*.ts",
    "./convert/*": "./src/convert/*.ts",
    "./security/*": "./src/security/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify-models": "node scripts/verify-models.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4"
  },
  "peerDependencies": {
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "onnxruntime-web": "1.30.0",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "@types/node": "^20"
  }
}
